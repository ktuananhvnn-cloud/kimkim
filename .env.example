# --- Anthropic ---
# Leave EMPTY if you're using a Claude Pro/Max subscription via `ant auth
# login` instead of a metered API key (see README "Dùng gói Claude Pro/Max").
# Fill in only if you want to pay per-token via console.anthropic.com instead.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Only used when ANTHROPIC_API_KEY is empty - must match the directory you
# ran `ant auth login` into, and must be mounted into the container at this
# same path (see docker-compose.yml).
ANTHROPIC_CONFIG_DIR=/anthropic-config

# --- Telegram ---
# Get this from @BotFather (see README "Setup Telegram bot")
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your own numeric Telegram user id (see README) - only this user can talk to the bot
TELEGRAM_OWNER_ID=123456789

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# service_role key, NOT the anon key (Project Settings -> API)
SUPABASE_SERVICE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Admin website ---
ADMIN_USERNAME=admin
# Generate with: python -c "from app.admin.auth import hash_password; print(hash_password('your-password'))"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=change-me-to-a-random-64-char-string
ADMIN_PORT=8080

# --- Market data ---
# "vndirect" (default/primary) or "vnstock" (fallback aggregator)
MARKET_DATA_SOURCE=vndirect

# --- Misc ---
TZ=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO
